# Optional settings used by the generalized operations scripts.
# Copy to .env and adjust for the target host. Never commit the populated file.

HOMELAB_HOST=localhost
TAILSCALE_HOSTNAME=your-host.your-tailnet.ts.net
STATUS_TIMEOUT=5

IMMICH_URL=http://localhost:2283
HOMEPAGE_URL=http://localhost:3000
PLEX_URL=

IMMICH_COMPOSE_FILE=compose/immich/compose.yaml
HOMEPAGE_COMPOSE_FILE=compose/homepage/compose.yaml
IMMICH_DB_USERNAME=immich
IMMICH_DB_NAME=immich

CONFIG_STORAGE_PATH=.
PHOTO_STORAGE_PATH=./runtime/immich/library
BACKUP_DIR=./backups
