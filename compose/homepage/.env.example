# Copy to .env and replace the example hostname and blank credentials.
TZ=Etc/UTC
PUID=0
PGID=0
HOMEPAGE_VERSION=latest
HOMEPAGE_BIND_ADDRESS=0.0.0.0
HOMEPAGE_PORT=3000

TAILSCALE_HOSTNAME=your-host.your-tailnet.ts.net
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,homepage:3000,your-host.your-tailnet.ts.net:3000

HOMEPAGE_CONFIG_PATH=../../config/homepage
HOST_STATS_PATH=../../runtime/homepage/host-stats
DOCKER_SOCKET_PATH=/var/run/docker.sock

HOMEPAGE_VAR_IMMICH_URL=http://your-host.your-tailnet.ts.net:2283
HOMEPAGE_VAR_IMMICH_API_KEY=
HOMEPAGE_VAR_PLEX_URL=http://your-host.your-tailnet.ts.net:32400
HOMEPAGE_VAR_PLEX_TOKEN=
HOMEPAGE_VAR_STORAGE_STATS_URL=http://127.0.0.1:3000/host-stats/storage.json
